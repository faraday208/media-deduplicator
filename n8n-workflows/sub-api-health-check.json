{
  "name": "[SUB] API Health Check & Retry",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "input",
      "name": "Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Gelen parametreleri al veya default kullan\nconst input = items[0].json;\n\n// Default start command - API'yi restart eder\nconst defaultStartCmd = '/home/ai/ai-visual-lab/dataset-prep/02-duplicate/scripts/restart-api.sh';\n\nconst config = {\n  api_url: input.api_url || 'http://127.0.0.1:8001',\n  health_endpoint: input.health_endpoint || '/health',\n  start_command: input.start_command || defaultStartCmd,\n  max_retries: input.max_retries || 3,\n  wait_seconds: input.wait_seconds || 5,\n  force_restart: input.force_restart !== undefined ? input.force_restart : false\n};\n\n// Sayacı sıfırla\nconst staticData = $getWorkflowStaticData('global');\nstaticData.retry_count = 0;\nstaticData.restarted = false;\n\nreturn [{ json: config }];"
      },
      "id": "init-config",
      "name": "Init Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "// API health check\nconst config = items[0].json;\nconst healthUrl = config.api_url + config.health_endpoint;\nconst staticData = $getWorkflowStaticData('global');\n\ntry {\n  const response = await this.helpers.httpRequest({\n    method: 'GET',\n    url: healthUrl,\n    timeout: 5000,\n  });\n  \n  if (response.status === 'healthy') {\n    // force_restart true ve henuz restart yapilmadiysa, restart yap\n    if (config.force_restart && !staticData.restarted) {\n      staticData.restarted = true;\n      return [{ json: { ...config, api_ready: false, error: 'Force restart - API yeniden baslatiliyor', needs_restart: true } }];\n    }\n    return [{ json: { ...config, api_ready: true, api_response: response } }];\n  } else {\n    return [{ json: { ...config, api_ready: false, error: 'API yanit verdi ama healthy degil', api_response: response } }];\n  }\n} catch (error) {\n  return [{ json: { ...config, api_ready: false, error: error.message, error_code: error.code || 'UNKNOWN' } }];\n}"
      },
      "id": "check-api",
      "name": "Check API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "api-ready",
              "leftValue": "={{ $json.api_ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-api-ready",
      "name": "API Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [820, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "success-status",
              "name": "success",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "success-url",
              "name": "api_url",
              "value": "={{ $json.api_url }}",
              "type": "string"
            },
            {
              "id": "success-message",
              "name": "message",
              "value": "API hazir",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "api-success",
      "name": "API Ready",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-command",
              "leftValue": "={{ $json.start_command }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-command",
      "name": "Has Start Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1040, 400]
    },
    {
      "parameters": {
        "command": "={{ $json.start_command }}"
      },
      "id": "start-api",
      "name": "Start API",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1260, 300]
    },
    {
      "parameters": {
        "amount": "={{ $('Init Config').item.json.wait_seconds }}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Retry sayacı\nconst staticData = $getWorkflowStaticData('global');\nconst config = $('Init Config').item.json;\n\nstaticData.retry_count = (staticData.retry_count || 0) + 1;\n\nconst currentRetry = staticData.retry_count;\nconst maxRetries = config.max_retries;\n\nreturn [{\n  json: {\n    ...config,\n    retry_count: currentRetry,\n    can_retry: currentRetry < maxRetries,\n    message: `Deneme ${currentRetry}/${maxRetries}`\n  }\n}];"
      },
      "id": "retry-counter",
      "name": "Retry++",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "can-retry",
              "leftValue": "={{ $json.can_retry }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-can-retry",
      "name": "Can Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1920, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fail-status",
              "name": "success",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "fail-url",
              "name": "api_url",
              "value": "={{ $json.api_url }}",
              "type": "string"
            },
            {
              "id": "fail-retries",
              "name": "retry_attempts",
              "value": "={{ $json.retry_count }}",
              "type": "number"
            },
            {
              "id": "fail-message",
              "name": "message",
              "value": "API baslatilamadi - max retry asildi",
              "type": "string"
            },
            {
              "id": "fail-error",
              "name": "last_error",
              "value": "={{ $json.error }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "api-failed",
      "name": "API Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
