        "jsCode": "// Scan sonucunu ve ozeti hazirla\nconst scanResult = items[0].json;\nconst config = $('CONFIG').item.json;\n\nconst summary = {\n  status: 'DUPLICATE BULUNDU',\n  duplicate_groups: scanResult.metadata.duplicate_groups,\n  duplicate_files: scanResult.metadata.total_duplicate_files,\n  space_to_free_mb: Math.round(scanResult.metadata.space_can_free_mb * 100) / 100,\n  report_json: scanResult.report_json,\n  groups: scanResult.groups,\n  // Config bilgileri\n  auto_delete: config.auto_delete,\n  keep_strategy: config.keep_strategy,\n  // Onay icin ozet mesaj\n  approval_message: `${scanResult.metadata.duplicate_groups} grup, ${scanResult.metadata.total_duplicate_files} dosya bulundu. ${Math.round(scanResult.metadata.space_can_free_mb * 100) / 100} MB kazanilabilir. Silmek icin onayla.`\n};\n\nreturn [{ json: summary }];"
