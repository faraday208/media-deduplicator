    {
      "parameters": {
        "formTitle": "Duplicate Image Scanner",
        "formDescription": "Tarama ayarlarını yapılandırın. Dizin yolunu girin ve seçenekleri belirleyin.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Taranacak Dizin",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "/mnt/sda1/Pictures",
              "defaultValue": "/mnt/storage/Characters/Berilsu/Pics"
            },
            {
              "fieldLabel": "Alt Klasörler Dahil",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Hayır" },
                  { "option": "Evet" }
                ]
              },
              "requiredField": true,
              "defaultValue": "Hayır"
            },
            {
              "fieldLabel": "Otomatik Sil",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Hayır (Onay iste)" },
                  { "option": "Evet (Direkt sil)" }
                ]
              },
              "requiredField": true,
              "defaultValue": "Hayır (Onay iste)"
            },
            {
              "fieldLabel": "Hangisi Kalsın",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "best (Çözünürlük > Boyut)" },
                  { "option": "highest_resolution (Sadece çözünürlük)" },
                  { "option": "largest (Dosya boyutu MB)" },
                  { "option": "smallest (En küçük dosya)" },
                  { "option": "first (İlk bulunan)" }
                ]
              },
              "requiredField": true,
              "defaultValue": "largest (Dosya boyutu MB)"
            },
            {
              "fieldLabel": "Benzerlik Eşiği (0-15)",
              "fieldType": "number",
              "requiredField": true,
              "placeholder": "10",
              "defaultValue": "5"
            },
            {
              "fieldLabel": "Benzerlik Algoritması",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "phash (Perceptual - Önerilen)" },
                  { "option": "average_hash (Average)" },
                  { "option": "dhash (Difference)" }
                ]
              },
              "requiredField": true,
              "defaultValue": "phash (Perceptual - Önerilen)"
            }
          ]
        },
        "options": {
          "respondWith": "redirect",
          "redirectUrl": "about:blank"
        }
      },
      "id": "7a2de96e-8705-4ff7-b7f8-fa73555f4ae1",
      "name": "Config Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -2688,
        224
      ],
      "webhookId": "dup-scanner-config"
    },
    {
      "parameters": {
        "jsCode": "// Form değerlerini API formatına çevir (default değerler dahil)\nconst form = items[0].json;\n\n// Default değerler\nconst DEFAULTS = {\n  directory: '/mnt/storage/Characters/Berilsu/Pics',\n  recursive: false,\n  auto_delete: false,\n  keep_strategy: 'largest',\n  similar_threshold: 5,\n  similar_algorithm: 'phash'\n};\n\n// Form değerlerini parse et (boşsa default kullan)\nconst directory = form['Taranacak Dizin'] || DEFAULTS.directory;\nconst recursive = form['Alt Klasörler Dahil'] ? form['Alt Klasörler Dahil'] === 'Evet' : DEFAULTS.recursive;\nconst auto_delete = form['Otomatik Sil'] ? form['Otomatik Sil'].startsWith('Evet') : DEFAULTS.auto_delete;\nconst keep_strategy = form['Hangisi Kalsın'] ? form['Hangisi Kalsın'].split(' ')[0] : DEFAULTS.keep_strategy;\nconst similar_threshold = form['Benzerlik Eşiği (0-15)'] || DEFAULTS.similar_threshold;\nconst similar_algorithm = form['Benzerlik Algoritması'] ? form['Benzerlik Algoritması'].split(' ')[0] : DEFAULTS.similar_algorithm;\n\nreturn [{\n  json: {\n    directory,\n    recursive,\n    auto_delete,\n    keep_strategy,\n    similar_threshold,\n    similar_algorithm\n  }\n}];"
      },
      "id": "a6ccce6e-e916-40bc-9af8-9c659619acd1",
      "name": "CONFIG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2544,
        224
      ],
      "notes": "Form değerlerini API formatına çevirir"
    },
    {
      "parameters": {
        "jsCode": "// Sub-workflow'a gönderilecek parametreler\nconst config = items[0].json;\n\nreturn [{\n  json: {\n    api_url: 'http://127.0.0.1:8001',\n    health_endpoint: '/health',\n    start_command: '/home/ai/ai-visual-lab/dataset-prep/02-duplicate/scripts/restart-api.sh',\n    max_retries: 3,\n    wait_seconds: 5,\n    force_restart: false,\n    // Original config'i de tasi\n    directory: config.directory,\n    recursive: config.recursive,\n    auto_delete: config.auto_delete,\n    keep_strategy: config.keep_strategy\n  }\n}];"
      },
