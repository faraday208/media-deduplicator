        "jsCode": "// Similar scan sonucunu ve ozeti hazirla\nconst scanResult = items[0].json;\nconst config = $('CONFIG').item.json;\n\nconst summary = {\n  status: 'BENZER RESIM BULUNDU',\n  similar_groups: scanResult.metadata.similar_groups_found,\n  similar_files: scanResult.metadata.total_similar_files,\n  removable_files: scanResult.metadata.removable_files,\n  space_to_free_mb: Math.round(scanResult.metadata.estimated_space_mb * 100) / 100,\n  report_json: scanResult.report_json,\n  groups: scanResult.groups,\n  // Config bilgileri\n  auto_delete: config.auto_delete,\n  keep_strategy: config.keep_strategy,\n  // Onay icin ozet mesaj\n  approval_message: `${scanResult.metadata.similar_groups_found} benzer grup, ${scanResult.metadata.removable_files} silinebilir dosya bulundu. ${Math.round(scanResult.metadata.estimated_space_mb * 100) / 100} MB kazanilabilir. Silmek icin onayla.`\n};\n\nreturn [{ json: summary }];"
